    <td style="background-color: #f8fafc; border: 1px solid #cbd5e1; font-size: 11pt; vertical-align: top;"><code style="font-family: Consolas;">user_id</code> -> <code style="font-family: Consolas;">users(id)</code><br/><code style="font-family: Consolas;">address_id</code> -> <code style="font-family: Consolas;">user_addresses(id)</code><br/><code style="font-family: Consolas;">promotion_id</code> -> <code style="font-family: Consolas;">promotions(id)</code></td>
