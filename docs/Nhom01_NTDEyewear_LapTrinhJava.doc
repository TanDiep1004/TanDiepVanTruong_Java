    <th style="background-color: #1e293b; color: #ffffff; font-weight: bold; text-align: center; border: 1px solid #94a3b8; font-size: 11.5pt;">Khóa ngoại (FK) & Quan hệ</th>
    <th style="background-color: #1e293b; color: #ffffff; font-weight: bold; text-align: center; border: 1px solid #94a3b8; font-size: 11.5pt;">Vai trò & Mục đích lưu trữ</th>
  </tr>
