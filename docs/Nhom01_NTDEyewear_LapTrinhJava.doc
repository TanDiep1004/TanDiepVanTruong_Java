    <td style="background-color: #ffffff; border: 1px solid #cbd5e1; font-size: 11pt; vertical-align: top;">Quản trị viên</td>
  </tr>
  <tr>
    <td style="background-color: #f8fafc; border: 1px solid #cbd5e1; font-size: 11pt; vertical-align: top;"><code style="font-family: Consolas;">POST</code></td>
    <td style="background-color: #f8fafc; border: 1px solid #cbd5e1; font-size: 11pt; vertical-align: top;"><code style="font-family: Consolas;">/api/admin/products</code></td>
    <td style="background-color: #f8fafc; border: 1px solid #cbd5e1; font-size: 11pt; vertical-align: top;">Thêm mới sản phẩm kính vào kho</td>
    <td style="background-color: #f8fafc; border: 1px solid #cbd5e1; font-size: 11pt; vertical-align: top;">JSON: <code style="font-family: Consolas;">ProductRequest</code></td>
    <td style="background-color: #f8fafc; border: 1px solid #cbd5e1; font-size: 11pt; vertical-align: top;">JSON: <code style="font-family: Consolas;">Product</code></td>
    <td style="background-color: #f8fafc; border: 1px solid #cbd5e1; font-size: 11pt; vertical-align: top;">Quản trị viên</td>
  </tr>
  <tr>
    <td style="background-color: #ffffff; border: 1px solid #cbd5e1; font-size: 11pt; vertical-align: top;"><code style="font-family: Consolas;">PUT</code></td>
    <td style="background-color: #ffffff; border: 1px solid #cbd5e1; font-size: 11pt; vertical-align: top;"><code style="font-family: Consolas;">/api/admin/products/{id}</code></td>
    <td style="background-color: #ffffff; border: 1px solid #cbd5e1; font-size: 11pt; vertical-align: top;">Cập nhật thông tin sản phẩm</td>
    <td style="background-color: #ffffff; border: 1px solid #cbd5e1; font-size: 11pt; vertical-align: top;">Path variable: <code style="font-family: Consolas;">id</code>, JSON body</td>
    <td style="background-color: #ffffff; border: 1px solid #cbd5e1; font-size: 11pt; vertical-align: top;">JSON: <code style="font-family: Consolas;">Product</code></td>
    <td style="background-color: #ffffff; border: 1px solid #cbd5e1; font-size: 11pt; vertical-align: top;">Quản trị viên</td>
  </tr>
  <tr>
    <td style="background-color: #f8fafc; border: 1px solid #cbd5e1; font-size: 11pt; vertical-align: top;"><code style="font-family: Consolas;">DELETE</code></td>
    <td style="background-color: #f8fafc; border: 1px solid #cbd5e1; font-size: 11pt; vertical-align: top;"><code style="font-family: Consolas;">/api/admin/products/{id}</code></td>
    <td style="background-color: #f8fafc; border: 1px solid #cbd5e1; font-size: 11pt; vertical-align: top;">Xóa kính khỏi hệ thống</td>
    <td style="background-color: #f8fafc; border: 1px solid #cbd5e1; font-size: 11pt; vertical-align: top;">Path variable: <code style="font-family: Consolas;">id</code></td>
    <td style="background-color: #f8fafc; border: 1px solid #cbd5e1; font-size: 11pt; vertical-align: top;">JSON: <code style="font-family: Consolas;">ApiResponse</code></td>
    <td style="background-color: #f8fafc; border: 1px solid #cbd5e1; font-size: 11pt; vertical-align: top;">Quản trị viên</td>
  </tr>
  <tr>
    <td style="background-color: #ffffff; border: 1px solid #cbd5e1; font-size: 11pt; vertical-align: top;"><code style="font-family: Consolas;">POST</code></td>
    <td style="background-color: #ffffff; border: 1px solid #cbd5e1; font-size: 11pt; vertical-align: top;"><code style="font-family: Consolas;">/api/admin/products/apply-all-variants</code></td>
    <td style="background-color: #ffffff; border: 1px solid #cbd5e1; font-size: 11pt; vertical-align: top;">Gán biến thể màu/độ hàng loạt cho toàn kho</td>
    <td style="background-color: #ffffff; border: 1px solid #cbd5e1; font-size: 11pt; vertical-align: top;">JSON: <code style="font-family: Consolas;">List<VariantDto></code></td>
    <td style="background-color: #ffffff; border: 1px solid #cbd5e1; font-size: 11pt; vertical-align: top;">JSON: Số lượng sản phẩm cập nhật</td>
    <td style="background-color: #ffffff; border: 1px solid #cbd5e1; font-size: 11pt; vertical-align: top;">Quản trị viên</td>
  </tr>
  <tr>
    <td style="background-color: #f8fafc; border: 1px solid #cbd5e1; font-size: 11pt; vertical-align: top;"><code style="font-family: Consolas;">GET</code></td>
    <td style="background-color: #f8fafc; border: 1px solid #cbd5e1; font-size: 11pt; vertical-align: top;"><code style="font-family: Consolas;">/api/admin/orders</code></td>
    <td style="background-color: #f8fafc; border: 1px solid #cbd5e1; font-size: 11pt; vertical-align: top;">Xem danh sách tất cả đơn hàng</td>
    <td style="background-color: #f8fafc; border: 1px solid #cbd5e1; font-size: 11pt; vertical-align: top;">Query params: lọc theo trạng thái</td>
    <td style="background-color: #f8fafc; border: 1px solid #cbd5e1; font-size: 11pt; vertical-align: top;">JSON: <code style="font-family: Consolas;">List<Order></code></td>
    <td style="background-color: #f8fafc; border: 1px solid #cbd5e1; font-size: 11pt; vertical-align: top;">Quản trị viên</td>
  </tr>
  <tr>
    <td style="background-color: #ffffff; border: 1px solid #cbd5e1; font-size: 11pt; vertical-align: top;"><code style="font-family: Consolas;">PUT</code></td>
    <td style="background-color: #ffffff; border: 1px solid #cbd5e1; font-size: 11pt; vertical-align: top;"><code style="font-family: Consolas;">/api/admin/orders/{id}/status</code></td>
    <td style="background-color: #ffffff; border: 1px solid #cbd5e1; font-size: 11pt; vertical-align: top;">Duyệt / Đổi trạng thái đơn hàng</td>
    <td style="background-color: #ffffff; border: 1px solid #cbd5e1; font-size: 11pt; vertical-align: top;">Path: <code style="font-family: Consolas;">id</code>, Query: <code style="font-family: Consolas;">status</code></td>
    <td style="background-color: #ffffff; border: 1px solid #cbd5e1; font-size: 11pt; vertical-align: top;">JSON: <code style="font-family: Consolas;">Order</code></td>
