    <td style="background-color: #ffffff; border: 1px solid #cbd5e1; font-size: 11pt; vertical-align: top;">JSON: <code style="font-family: Consolas;">OrderResponse</code></td>
    <td style="background-color: #ffffff; border: 1px solid #cbd5e1; font-size: 11pt; vertical-align: top;">Khách hàng</td>
  </tr>
  <tr>
    <td style="background-color: #f8fafc; border: 1px solid #cbd5e1; font-size: 11pt; vertical-align: top;"><code style="font-family: Consolas;">GET</code></td>
    <td style="background-color: #f8fafc; border: 1px solid #cbd5e1; font-size: 11pt; vertical-align: top;"><code style="font-family: Consolas;">/api/customer/orders</code></td>
