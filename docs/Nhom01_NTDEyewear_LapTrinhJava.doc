    <td style="background-color: #f8fafc; border: 1px solid #cbd5e1; font-size: 11pt; vertical-align: top;"><code style="font-family: Consolas;">/api/admin/users</code></td>
    <td style="background-color: #f8fafc; border: 1px solid #cbd5e1; font-size: 11pt; vertical-align: top;">Quản trị danh sách người dùng</td>
